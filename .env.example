# Copy to ".env" in the project root and fill in values.
#   copy .env.example .env
# The app loads this file automatically (see backend/app/core/config.py).
# .env is gitignored — do not commit real API keys.

# --- Vector store ---
VECTOR_STORE=local
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=research_chunks
# Qdrant has no Faiss "FLAT" type; exact=true does full-scan search (local parity).
# QDRANT_EXACT_SEARCH=true

# --- Cloud VLM (OpenAI-compatible: 硅基流动 / 阿里云百炼) ---
ENABLE_CLOUD_VLM=true
VLM_API_BASE=https://api.siliconflow.cn/v1
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_SECONDS=60
# 0 = unlimited; set e.g. 5 to cap calls per document
VLM_MAX_CALLS=0

# --- Answer LLM (final generation; may be a VL model) ---
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- Router LLM: KB assign + query routing + query rewrite (prefer cheap text model) ---
# Empty fields fall back to the corresponding LLM_* value.
ROUTER_LLM_API_BASE=https://api.siliconflow.cn/v1
ROUTER_LLM_API_KEY=
ROUTER_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
ROUTER_LLM_TIMEOUT_SECONDS=60
KB_ROUTE_TOP_N=3

# --- CLIP multimodal (1A: unified text/image space) ---
# After enabling, re-ingest documents (force_reindex) so text_vec uses CLIP.
ENABLE_CLIP_MULTIMODAL=true
CLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
CLIP_IMAGE_MODEL=clip-ViT-B-32
# CLIP ViT-B/32 embedding size is typically 512 (auto when CLIP on)
# EMBEDDING_DIMENSIONS=512
# Set ENABLE_CLIP_MULTIMODAL=false to use MiniLM single-vector mode (often 384).

# --- Reranker (SiliconFlow /v1/rerank; separate key from LLM) ---
RERANKER_PROVIDER=cloud
RERANKER_API_BASE=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=30

RETRIEVAL_LOW_CONFIDENCE_THRESHOLD=0.35
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RETRY_CANDIDATE_K=40
QUERY_MAX_SUB_QUERIES=4
